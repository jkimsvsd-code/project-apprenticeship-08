# Node.js 24 / 로컬 개발 예시. 운영은 고정된 HTTPS Origin을 사용합니다.
# 모든 값은 서버 전용입니다. VITE_ 접두사로 비밀값을 공개하지 않습니다.
APP_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="J · 나만의 공간"
PORT=3000
DATABASE_PATH=runtime/app.sqlite
# 단위: 초. 질문 30~600, 세션 60~86400 범위입니다.
CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=3600
# Vercel 배포 전용. 로컬 SQLite 실행에는 필요하지 않습니다. 실제 값은 커밋하지 않습니다.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
