{
  "name": "apprenticeship-08-passkey-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "vercel-build": "node scripts/prepare-vercel.mjs",
    "db:migrate:postgres": "node --env-file=.env.production.local --import tsx scripts/migrate-postgres.ts",
    "bootstrap:postgres": "node --env-file=.env.production.local --import tsx scripts/bootstrap-postgres.ts",
    "test:postgres": "node --env-file=.env.production.local --import tsx scripts/check-postgres.ts",
    "start": "node --env-file-if-exists=.env --import ./scripts/production.mjs dist/server/server/index.js",
    "bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:production": "node scripts/smoke-production.mjs",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@vercel/functions": "3.6.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.62.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  }
}
